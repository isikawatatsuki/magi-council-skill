{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magi/vote.schema.json",
  "title": "MAGI sealed vote",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "persona",
    "decision",
    "confidence",
    "summary",
    "reasons",
    "conditions",
    "risks",
    "assumptions",
    "memoryCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string"
    },
    "persona": {
      "enum": [
        "melchior",
        "balthasar",
        "casper"
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "abstain"
      ]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "statement",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{2,40}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "statement",
          "mitigated"
        ],
        "properties": {
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "mitigated": {
            "type": "boolean"
          },
          "mitigation": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "memoryCandidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principle",
          "scopes",
          "applicableWhen",
          "notApplicableWhen",
          "rationale"
        ],
        "properties": {
          "principle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "applicableWhen": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "notApplicableWhen": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
