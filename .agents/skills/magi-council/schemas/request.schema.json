{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magi/request.schema.json",
  "title": "MAGI request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "status",
    "question",
    "context",
    "expectedPersonas",
    "voting"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^magi-[a-z0-9-]{16,64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "collecting",
        "ready",
        "finalized",
        "invalid"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "context": {
      "type": "object"
    },
    "expectedPersonas": {
      "const": [
        "melchior",
        "balthasar",
        "casper"
      ]
    },
    "executionMode": {
      "enum": [
        "sealed-subagents",
        "inline"
      ]
    },
    "voting": {
      "type": "object",
      "required": [
        "method",
        "criticalRiskVeto"
      ],
      "properties": {
        "method": {
          "const": "majority"
        },
        "criticalRiskVeto": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
